# GEMINI_API_KEY: Optional - enables live Gemini 2.5 Flash API calls.
# If omitted or left as default, LEGALENS uses its internal Grounded Intelligence engine.
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server port for development and production (default: 3000)
PORT=3000

# APP_URL: Optional base URL where the application is hosted
APP_URL="http://localhost:3000"
